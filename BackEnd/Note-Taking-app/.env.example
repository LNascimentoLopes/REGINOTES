# ==========================================
# Configurações do Servidor
# ==========================================
SERVER_PORT=8080

# ==========================================
# Configurações do Banco de Dados (PostgreSQL)
# ==========================================
DB_URL=jdbc:postgresql://localhost:5432/nome_do_seu_banco
DB_USERNAME=seu_usuario_aqui
DB_PASSWORD=sua_senha_aqui

# ==========================================
# Configurações de Segurança (JWT)
# ==========================================
# Gere uma chave forte (ex: SHA-256) e cole no seu .env real
JWT_SECRET=sua_chave_secreta_super_segura_com_mais_de_256_bits_aqui
JWT_EXPIRATION_TIME=3600000